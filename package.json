{
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "bun run --parallel --filter='./packages/**' build",
    "format": "biome check --write",
    "lint": "biome check",
    "test": "bun run --parallel --filter='./packages/**' test"
  },
  "overrides": {
    "rolldown": "1.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@gameroman/config": "0.2.9",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
