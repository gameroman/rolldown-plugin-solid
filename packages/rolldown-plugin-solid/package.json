  },
  "devDependencies": {
    "@gameroman/config": "0.2.9",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "rolldown": "1.2.5",
    "solid-js": "1.9.15",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "csstype": "^3.1.0",
    "rolldown": "^1.0.0",
    "solid-js": ">=1.9.15"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
